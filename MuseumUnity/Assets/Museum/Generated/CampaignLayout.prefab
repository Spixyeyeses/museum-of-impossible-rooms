  sourceJson: "{\"id\":\"last-note\",\"room\":\"courtyard\",\"p\":[2.5,1.1,-1],\"type\":\"note\",\"label\":\"Iona Vale, outside\",\"radius\":0.65,\"title\":\"Iona Vale, outside\",\"text\":\"I am safely outside. The door held. I have left the gate open for you.\\n\\nI thought that preserving this museum meant finishing its plan. You have shown me that a building can remain unfinished and still make room for someone.\\n\\nThe second cup is yours.\\n\u2014 Iona Vale\"}"
