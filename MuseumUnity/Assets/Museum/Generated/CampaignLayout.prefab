  initiallyAvailable: 1
  sourceJson: "{\"id\":\"c10-note\",\"room\":\"c10\",\"p\":[-3,1.1,8],\"type\":\"note\",\"label\":\"Three corrections\",\"radius\":0.65,\"title\":\"Three corrections\",\"text\":\"OPEN \u2014 A half measure, carried through an impossible interior.\\nHOLD \u2014 Release the arrangement from your attention.\\nRELEASE \u2014 A view from the other floor.\\n\\nYou have already learned every part of this route. There is no secret sequence. Follow the named exhibitions.\"}"
