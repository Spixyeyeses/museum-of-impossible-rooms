  sourceJson: '{"id":"c7-note","room":"c7","p":[-2.5,1.1,5],"type":"note","label":"A route without a fixed scale","radius":0.65,"title":"A route without a fixed scale","text":"The measuring arch halves all that passes. Its reverse doubles. The blue return preserves measure.\n\nThe little collection accepts one quarter of the starting weight. Find a route whose two halves do not undo one another."}'
