  sourceJson: "{\"id\":\"c2-note\",\"room\":\"c2\",\"p\":[-3,1.1,4],\"type\":\"note\",\"label\":\"The inside exceeds the outside\",\"radius\":0.65,\"title\":\"The inside exceeds the outside\",\"text\":\"The west collection holds the weight. The east collection holds its plinth. The archive\u2019s glass partition has no opening. Both collections belong to this little pavilion.\"}"
