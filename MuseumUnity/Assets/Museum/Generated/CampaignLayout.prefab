  sourceJson: "{\"id\":\"c5-lore\",\"room\":\"c5-beyond\",\"p\":[-2,1.1,1],\"type\":\"lore\",\"label\":\"Here\",\"radius\":0.65,\"title\":\"Here\",\"text\":\"A sculptor tried to represent every view of a doorway at once. The result had no opening.\\n\\n\u201CA perspective is useful. It need not be universal.\u201D \u2014 I.V.\"}"
