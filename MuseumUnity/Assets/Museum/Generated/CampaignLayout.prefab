  destinationId: 
  initiallyAvailable: 1
  sourceJson: "{\"id\":\"c9-lore\",\"room\":\"c9-record\",\"p\":[3,1.1,2],\"type\":\"lore\",\"label\":\"The three corrections\",\"radius\":0.65,\"title\":\"The three corrections\",\"text\":\"The last plan has three corrections:\\n\\nOPEN \u2014 a room may be larger than its enclosure. Carry a half measure into its index.\\nHOLD \u2014 attention holds an arrangement. Release it to reach the other floor.\\nRELEASE \u2014 take that floor\u2019s viewpoint. A complete outline admits the sky.\\n\\nThere is no combination to guess. Only a route to understand.\"}"
