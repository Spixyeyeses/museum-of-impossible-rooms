  sourceJson: "{\"id\":\"c8-note\",\"room\":\"c8\",\"p\":[-2.5,1.1,5],\"type\":\"note\",\"label\":\"The same arch, another agreement\",\"radius\":0.65,\"title\":\"The same arch, another agreement\",\"text\":\"The collection keeps a full weight. Conservation needs a half measure.\\n\\nRelease the arrangement, give it a moment outside your view, and the same frame takes on another destination \u2014 and another measure.\"}"
