  m_Name: 
  m_EditorClassIdentifier: Museum.Runtime::Museum.MuseumAnchor
  sourceId: welcome
  roomId: hub
  kind: interactable
  destinationId: 
  initiallyAvailable: 1
  sourceJson: '{"id":"welcome","room":"hub","p":[0,1.1,7],"type":"note","label":"To the visitor","radius":0.65,"title":"To the visitor","text":"My name is Iona Vale. I tried to draw a final plan of this museum. The plan became so exact that it left no room for an exit.\n\nI am still here, making corrections. Follow the numbered exhibitions. Bring each index weight to its matching plinth. Learn what a doorway actually promises.\n\nWhen you have understood the building, please leave a way out for both of us."}'
