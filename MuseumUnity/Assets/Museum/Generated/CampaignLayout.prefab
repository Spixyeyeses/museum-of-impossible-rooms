  sourceJson: '{"id":"c5-note","room":"c5","p":[3,1.1,5],"type":"note","label":"One useful viewpoint","radius":0.65,"title":"One useful viewpoint","text":"Stand on the ivory rings. Let the scattered frames become a single outline. Hold that view for one quiet breath.\n\nA discovered connection remains available. You are free to look around after it settles."}'
